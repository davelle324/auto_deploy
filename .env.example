# Copy this file to .env and fill in your values.
# Generate a strong secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-string

# SQLite database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./auto_deploy.db

# Set to true to enable SQLAlchemy query logging
DEBUG=false
