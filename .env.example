# Copy this file to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────

# Secret key used to sign session cookies and encrypt stored API tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-string

# ── Authentication ────────────────────────────────────────────────────────────

# Password required to access the dashboard.
# Leave empty (or unset) to disable authentication — recommended for local dev.
# Set this when deploying publicly (e.g. on Fly.io).
APP_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────

# Path to the SQLite database file.
# When deploying to Fly.io with a persistent volume mounted at /data, use:
#   DATABASE_URL=sqlite+aiosqlite:////data/auto_deploy.db
DATABASE_URL=sqlite+aiosqlite:///./auto_deploy.db

# ── Optional ──────────────────────────────────────────────────────────────────

# Display name shown in the browser tab and dashboard header.
APP_NAME=Auto Deploy

# Set to true to enable SQLAlchemy query logging (verbose — for debugging only).
DEBUG=false
